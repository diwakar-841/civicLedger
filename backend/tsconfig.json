{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "noImplicitAny": false,
    "maxNodeModuleJsDepth": 0,
    "types": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "../database"
  ]
}
